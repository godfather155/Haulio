# Database
DATABASE_URL=
REDIS_URL=

# Auth
SESSION_SECRET=
CSRF_SECRET=

# Web / API URLs
# Public API URL used by Next.js apps
NEXT_PUBLIC_API_URL=
# Canonical web app origin used by the API for reset/invite links
WEB_ORIGIN=

# API server
PORT=3000
HOST=0.0.0.0

# Scripts
API_BASE=

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# Billing/invoice defaults
INVOICE_PREFIX=INV-

# Email (SMTP) for password resets
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=
RETURN_RESET_URL=false
