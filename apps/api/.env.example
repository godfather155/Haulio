# -------- Required --------
# PostgreSQL connection string used by Prisma.
DATABASE_URL=

# Canonical web app origin used for CORS and links (e.g., https://app.example.com)
WEB_ORIGIN=

# Session/csrf signing secrets (set strong random values)
SESSION_SECRET=
CSRF_SECRET=

# -------- Server runtime --------
# Render provides PORT automatically; defaults to 3000 when absent.
PORT=3000
# Optional bind host. Keep 0.0.0.0 in container/server environments.
HOST=0.0.0.0
# NODE_ENV should be production in deployment.
NODE_ENV=production

# -------- CORS --------
# Comma-separated allowed origins. Defaults to WEB_ORIGIN.
CORS_ALLOWED_ORIGINS=
# Allow localhost browser origins (recommended false in production).
CORS_ALLOW_LOCALHOST=false

# -------- Logging / error detail --------
# Access log for incoming requests.
REQUEST_LOGGING_ENABLED=true
# Include /health in request logs.
REQUEST_LOGGING_INCLUDE_HEALTH=false
# Include internal error details in API responses.
ERROR_INCLUDE_DETAILS=false

# -------- Uploads --------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# -------- Email (optional, password reset emails) --------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=
# If true, returns reset URL in API response when email sending is unavailable.
RETURN_RESET_URL=false

# -------- Optional integrations --------
SAMSARA_API_BASE=https://api.samsara.com
SAMSARA_TIMEOUT_MS=8000

# -------- Feature flags / limits --------
LOAD_CONFIRMATION_LEARNING_LIMIT=500
LOAD_CONFIRMATION_LEARNING_MAX_BYTES=52428800
LEARNING_SIMILARITY_THRESHOLD=0.82
LEARNING_CHARGE_SIMILARITY_THRESHOLD=0.75
YARD_STORAGE_ENABLED=false
DEBUG_DB_INFO=false
ALLOW_AUDIT_LOG_DELETE=false

# -------- Runtime compatibility aliases (optional) --------
# Legacy aliases still recognized by app code.
API_PORT=
API_HOST=
